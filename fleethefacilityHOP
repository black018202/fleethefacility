local ComputerESP = SavedConfig.ComputerESP

-- Função para identificar exatamente os computadores de objetivo
local function IsGameComputer(obj)
    if not (obj:IsA("Model") or obj:IsA("Folder")) then return false end
    
    local name = string.lower(obj.Name)
    
    -- No Flee the Facility, os computadores reais costumam ser chamados de "ComputerTable" ou contêm "ComputerTrigger"
    if string.find(name, "computertable") or string.find(name, "computer") then
        -- Verifica se possui a tela/monitor interativo ou os botões de hackear
        if obj:FindFirstChild("ComputerTrigger") or obj:FindFirstChild("Screen") or obj:FindFirstChild("Keyboard") then
            return true
        end
    end
    
    return false
end

local function AddComputerESP(obj)
    if not ComputerESP then return end
    if not IsGameComputer(obj) then return end
    if obj:FindFirstChild("ComputerESP") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ComputerESP"
    highlight.FillColor = Color3.fromRGB(0, 150, 255)
    highlight.OutlineColor = Color3.fromRGB(0, 255, 255)
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.Parent = obj
end

local function AddAllComputers()
    for _, obj in ipairs(workspace:GetDescendants()) do
        AddComputerESP(obj)
    end
end

local function RemoveComputerESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        local esp = obj:FindFirstChild("ComputerESP")
        if esp then
            esp:Destroy()
        end
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if ComputerESP then
        task.wait(0.5)
        AddComputerESP(obj)
    end
end)

