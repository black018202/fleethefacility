local function IsBeast(player)
    local hammer = player.Character and player.Character:FindFirstChild("Hammer")
    if hammer then return true end
    if player.Backpack and player.Backpack:FindFirstChild("Hammer") then return true end
    return false
end

-- 1. ESP JOGADORES
local PlayerESP = SavedConfig.PlayerESP

local function PlayerHighlight(player)
    if player == LocalPlayer then return end

    local character = player.Character
    if not character then return end
    if character:FindFirstChild("PlayerESP") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerESP"
    
    if IsBeast(player) then
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    else
        highlight.FillColor = Color3.fromRGB(0, 255, 0)
        highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
    end

    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = character
end

local function RemovePlayerESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local esp = player.Character:FindFirstChild("PlayerESP")
            if esp then
                esp:Destroy()
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if PlayerESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local esp = player.Character:FindFirstChild("PlayerESP")
                if esp then
                    if IsBeast(player) then
                        esp.FillColor = Color3.fromRGB(255, 0, 0)
                        esp.OutlineColor = Color3.fromRGB(255, 0, 0)
                    else
                        esp.FillColor = Color3.fromRGB(0, 255, 0)
                        esp.OutlineColor = Color3.fromRGB(0, 255, 0)
                    end
                else
                    PlayerHighlight(player)
                end
            end
        end
    end
end)

Players.PlayerAdded:Connect(function(player)
